        <mxCell id="v2" value="Physical view (4+1) – Sơ đồ triển khai (UML 2.0) – Chat với tài liệu (MVP), triển khai tại chỗ – SAD-CWD-002 mục 5.4" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#333333;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="1500" height="28" as="geometry"/></mxCell>
        <mxCell id="v3" value="Môi trường Production (thí điểm, tài liệu thật – chỉ sau khi có DEP-001)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="1500" height="790" as="geometry"/></mxCell>
        <mxCell id="v4" value="Mạng nội bộ của công ty (tại chỗ)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=3;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="330" y="75" width="775" height="735" as="geometry"/></mxCell>
        <mxCell id="v5" value="Bên ngoài hệ thống" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=3;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1270" y="75" width="250" height="735" as="geometry"/></mxCell>
        <mxCell id="v6" value="&lt;b&gt;«device»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Máy người dùng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Windows / macOS · LAN hoặc VPN · [TBD: số lượng ≤ 20 người]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#E1D5E7;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="v7" value="«artifact»&lt;br&gt;Vue SPA (chạy trong Chrome / Edge ≥ 1280 px)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="62" y="208" width="176" height="46" as="geometry"/></mxCell>
        <mxCell id="v8" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Máy chủ web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OS: [TBD] · cấu hình: [TBD – chốt sau thử tải G4]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#D5E8D4;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="v9" value="«artifact»&lt;br&gt;frontend bundle (tệp tĩnh)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="395" y="200" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="v10" value="«artifact»&lt;br&gt;cấu hình TLS + chuyển tiếp API" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="395" y="248" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="v11" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nút ứng dụng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OS: [TBD] · CPU cho OCR nếu dùng Tesseract · cấu hình: [TBD]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#DAE8FC;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="390" height="260" as="geometry"/></mxCell>
        <mxCell id="v12" value="«artifact»&lt;br&gt;backend image: FastAPI (API + SSE)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="200" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="v13" value="«artifact»&lt;br&gt;worker (cùng ảnh, tiến trình riêng): ingest, scheduler" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="246" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="v14" value="«artifact»&lt;br&gt;cấu hình và bí mật: khóa AI, SSO (chỉ ở máy chủ)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="292" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="v15" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Kho tệp&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Đĩa mã hóa hoặc NAS [TBD] · dung lượng ≥ 25 GB (cận trên)&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFE6CC;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="v16" value="«artifact»&lt;br&gt;PDF gốc (chỉ truy cập qua mô-đun storage)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="395" y="500" width="220" height="44" as="geometry"/></mxCell>
        <mxCell id="v17" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Máy chủ cơ sở dữ liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OS: [TBD] · bộ nhớ ≥ ~3,6 GB cho vector + chỉ mục (cận trên, giả định)&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFE6CC;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="v18" value="«artifact»&lt;br&gt;PostgreSQL + pgvector: Document, Chunk, jobs, phiên, nhật ký, telemetry" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="725" y="495" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="v19" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Máy sao lưu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Bản sao hằng ngày: RPO ≤ 24 giờ, RTO ≤ 1 ngày làm việc&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFF2CC;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="520" y="630" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="v20" value="«artifact»&lt;br&gt;bản sao lưu DB + ảnh chụp kho tệp (có ngoại lệ BR-029, Q-A3)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="545" y="706" width="290" height="54" as="geometry"/></mxCell>
        <mxCell id="v21" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tường lửa / egress allow-list&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;chỉ cho SSO và dịch vụ AI / OCR đã duyệt&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F4CCCC;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1130" y="140" width="100" height="170" as="geometry"/></mxCell>
        <mxCell id="v22" value="&lt;b&gt;«external»&lt;/b&gt;&lt;br&gt;&lt;b&gt;SSO công ty (IdP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;OIDC hoặc SAML [TBD – PD-001]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1290" y="120" width="215" height="80" as="geometry"/></mxCell>
        <mxCell id="v23" value="&lt;b&gt;«external»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Dịch vụ AI bên ngoài&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;nhúng + sinh câu trả lời [TBD – AD-06]; DEP-001&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1290" y="290" width="215" height="90" as="geometry"/></mxCell>
        <mxCell id="v24" value="&lt;b&gt;«external»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Dịch vụ OCR đám mây&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;tuỳ chọn, nếu chọn sau DEP-005&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1290" y="430" width="215" height="80" as="geometry"/></mxCell>
        <mxCell id="e25" value="HTTPS 443 (TLS 1.2+)" style="endArrow=open;endSize=8;html=1;rounded=0;strokeColor=#333333;startArrow=open;startSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v6" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
