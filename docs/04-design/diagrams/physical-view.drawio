        <mxCell id="e28" value="đọc/ghi tệp (mount đĩa mã hóa / NAS)" style="endArrow=open;endSize=8;html=1;rounded=0;strokeColor=#333333;startArrow=open;startSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v11" target="v15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="739" y="400"/><mxPoint x="505" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e29" value="HTTPS 443" style="endArrow=open;endSize=8;html=1;rounded=0;strokeColor=#333333;startArrow=open;startSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v11" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e30" value="OIDC / SAML" style="endArrow=open;endSize=8;html=1;rounded=0;strokeColor=#333333;startArrow=open;startSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e31" value="HTTPS 443" style="endArrow=open;endSize=8;html=1;rounded=0;strokeColor=#333333;startArrow=open;startSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e32" value="HTTPS 443 (tuỳ chọn)" style="endArrow=open;endSize=8;html=1;rounded=0;strokeColor=#333333;startArrow=open;startSize=8;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="v21" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e33" value="sao lưu hằng ngày" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="sao lưu hằng ngày" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="v15" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e35" value="chuyển hướng đăng nhập (HTTPS)" style="endArrow=open;endSize=8;dashed=1;html=1;rounded=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="v6" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="100"/><mxPoint x="1397" y="100"/></Array></mxGeometry></mxCell>
        <mxCell id="v36" value="Môi trường Staging" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="740" height="190" as="geometry"/></mxCell>
        <mxCell id="v37" value="&lt;b&gt;«node»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Nút ứng dụng + CSDL + kho tệp (thu nhỏ)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cùng cấu trúc với Production, tại chỗ · cấu hình [TBD]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#DAE8FC;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="905" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="v38" value="Mục đích: thử tải G4 (20 người dùng đồng thời, kho ≥ 200 tài liệu mẫu, DEP-003), quét bảo mật G5, kiểm thử gói tin telemetry G8, thử khôi phục G10. Dữ liệu mẫu, không dùng tài liệu thật." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#333333;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="410" y="905" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="v39" value="Chưa có kết nối ra dịch vụ AI thật cho tới khi có phê duyệt (DEP-001); dùng dịch vụ giả lập hoặc dữ liệu công khai khi kiểm thử." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=9;fontStyle=2;fontColor=#333333;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="410" y="1000" width="340" height="40" as="geometry"/></mxCell>
        <mxCell id="v40" value="Môi trường Development" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="790" y="860" width="740" height="190" as="geometry"/></mxCell>
        <mxCell id="v41" value="&lt;b&gt;«device»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Máy lập trình viên&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;chạy cả ngăn xếp cục bộ [TBD: Docker Compose]&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#E1D5E7;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="820" y="905" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="v42" value="Dữ liệu giả; không dùng tài liệu thật; bộ nối AI và OCR ở chế độ giả lập. Giao diện chạy bằng máy chủ phát triển của Vue; backend chạy FastAPI cục bộ." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#333333;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1170" y="905" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="v43" value="Chú thích: hình khối = nút (node); hình ghi chú = artifact được triển khai; nét liền hai đầu = đường truyền thông (có giao thức, cổng); nét đứt = phụ thuộc. Cấu hình phần cứng, hệ điều hành và cổng nội bộ đang [TBD], sẽ chốt sau kiểm kê hạ tầng và thử tải G4. Triển khai một nút ứng dụng; chưa có nhiều nút (RA-05)." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="1062" width="1500" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
