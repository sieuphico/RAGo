        <mxCell id="v50" value="[người dùng bấm Dừng hoặc kết nối đứt: giữ phần đã nhận, &quot;Đã dừng&quot; / &quot;Mất kết nối – chưa đầy đủ&quot;]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=10;fontStyle=2;fontColor=#333333;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="340" y="1146" width="900" height="18" as="geometry"/></mxCell>
        <mxCell id="v51" value="Chú thích: máy chủ đổi nhãn [cN] thành trích dẫn và bỏ nhãn không có trong tập chunk đã gửi. Mũi tên liền đầu đặc = gọi đồng bộ; mũi tên liền đầu mở = sự kiện bất đồng bộ (SSE); nét đứt = trả về. Không đủ bằng chứng thì không gọi AI (US-023). Mỗi trích dẫn chỉ trỏ tới chunk đã gửi cho AI (AD-13). Người dùng chỉ thấy câu trả lời kèm trích dẫn; tên tệp không rời hệ thống." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1488" width="1600" height="30" as="geometry"/></mxCell>
