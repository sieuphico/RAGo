        <mxCell id="e61" value="ghi chunk, chỉ mục" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Arial;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v27" target="v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v62" value="Chú thích: nút tròn đặc = khởi đầu; vòng đôi = kết thúc; thanh đen = tách (fork) / hợp (join) song song; hình thoi = rẽ nhánh / hợp nhánh; nét đứt = luồng đối tượng (dữ liệu). Giới hạn thời gian xử lý (p90): PDF có văn bản ≤ 3 phút, bản quét 100 trang ≤ 15 phút (NFR-002). OCR đã chọn sau thử nghiệm DEP-005 (AD-06). Chỉ OCR đám mây và nhúng gửi dữ liệu ra ngoài (CON-005)." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontSize=10;fontStyle=0;fontColor=#555555;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1498" width="1720" height="28" as="geometry"/></mxCell>
      </root>
