# Mẫu cấu hình cho môi trường chạy thật. Sao chép thành `.env`, quyền 0600, KHÔNG commit.
# Bí mật lấy từ kho bí mật hoặc đặt trực tiếp ở máy chủ; không đưa vào ảnh.

# --- Dành cho dịch vụ db trong compose.prod.yml
POSTGRES_USER=cwd
POSTGRES_PASSWORD=
POSTGRES_DB=cwd
# CWD_DATABASE_URL phải khớp ba giá trị trên

# --- Ứng dụng (CONTRACTS mục 7; bắt buộc: database_url, session_secret, telemetry_secret, embedding_dim)

# postgresql+asyncpg://cwd:<mật khẩu>@db:5432/cwd
CWD_DATABASE_URL=
# ít nhất 32 ký tự ngẫu nhiên
CWD_SESSION_SECRET=
# ít nhất 32 ký tự ngẫu nhiên, khác session_secret
CWD_TELEMETRY_SECRET=
# /srv/storage (đã gắn volume)
CWD_STORAGE_ROOT=
# khớp mô hình nhúng (qwen3-embedding:0.6b = 1024)
CWD_EMBEDDING_DIM=
# ollama | fake
CWD_AI_PROVIDER=
CWD_AI_API_KEY=
# http://host.docker.internal:11434 hoặc máy chủ Ollama nội bộ
CWD_OLLAMA_BASE_URL=
CWD_OLLAMA_CHAT_MODEL=
CWD_OLLAMA_EMBED_MODEL=
CWD_OCR_ENGINE=
CWD_IDP=
# IdP giả nhận email bất kỳ: chỉ đặt true ở dev/staging; môi trường thật dùng IdP thật (T-006)
CWD_ALLOW_FAKE_IDP=false
CWD_SESSION_TTL_S=
CWD_MAX_UPLOAD_MB=
CWD_MAX_FILES=
CWD_MAX_PAGES=
CWD_MAX_QUESTION_CHARS=
CWD_AI_TIMEOUT_S=
CWD_AI_SLOW_NOTICE_S=
CWD_AI_MONTHLY_BUDGET_USD=
CWD_AI_BUDGET_ALERT_RATIO=
CWD_AI_PRICE_INPUT_USD_PER_1K=
CWD_AI_PRICE_OUTPUT_USD_PER_1K=
CWD_TIMEZONE=
CWD_AI_CIRCUIT_FAILURES=
CWD_AI_CIRCUIT_OPEN_S=
CWD_EMBED_BATCH_SIZE=
CWD_RETRIEVAL_K=
CWD_RELEVANCE_THRESHOLD=
CWD_CHUNK_TARGET_CHARS=
CWD_CHUNK_OVERLAP_CHARS=
CWD_OCR_MIN_CONFIDENCE=
CWD_HISTORY_DAYS=
CWD_AUDIT_DAYS=
CWD_PURGE_HOURS=
CWD_JOB_MAX_ATTEMPTS=
CWD_JOB_STALE_AFTER_S=
CWD_FEATURES=
CWD_APP_VERSION=
CWD_WORKER_METRICS_PORT=

# --- Cổng web
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
CERTS_DIR=./certs   # chứa tls.crt và tls.key
